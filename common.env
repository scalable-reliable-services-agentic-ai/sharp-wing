# Kafka Configuration
KAFKA_BROKER=kafka:29092
KAFKA_RAW_TRANSACTIONS_TOPIC=raw-transactions
KAFKA_VALIDATED_TRANSACTIONS_TOPIC=validated-transactions
KAFKA_INVALID_TRANSACTIONS_TOPIC=invalid-transaction
KAFKA_NOANOMALY_TRANSACTIONS_TOPIC=noanomaly-transactions
KAFKA_ANOMALY_DETECTED_TRANSACTIONS_TOPIC=anomaly-detected-transactions
KAFKA_HUMAN_REVIEW_REQUIRED_TOPIC=human-review-required
KAFKA_FINAL_TRANSACTIONS_TOPIC=final-transactions

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# TimescaleDB/PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_DB=transactions
DB_HOST=timescaledb

# Batch Ingestor Configuration
BATCH_SIZE=5000
BATCH_INTERVAL=2

# Generator Configuration
GENERATOR_MIN_SLEEP_MS=150
GENERATOR_MAX_SLEEP_MS=2000

# Validator Configuration
VALIDATOR_MIN_AMOUNT=0
VALIDATOR_MAX_AMOUNT=100000
